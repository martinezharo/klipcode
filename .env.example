# Copy to .env for local development with `pnpm dev` (Node runtime).
# For `pnpm preview` / `pnpm deploy` (Cloudflare Workers runtime), the same
# values must live in .dev.vars instead — wrangler does not read .env.
# In production, set them as Worker secrets: wrangler secret put <NAME>
#
# NEXT_PUBLIC_CONVEX_URL is NOT listed here: `pnpm dev:backend` writes it (and
# CONVEX_DEPLOYMENT) into .env.local for you. Without a deployment URL, sign-in
# and cloud storage are unavailable; only the device-bound guest workspace is
# available.

# Master key (KEK) that wraps every per-user data-encryption key. It must be
# 32 random bytes in base64 — generate one with: openssl rand -base64 32
# Deliberately kept on Cloudflare and NEVER set as a Convex environment
# variable: that separation is what stops the encrypted records and the key
# that opens them from living with the same provider.
# Losing it makes all encrypted cloud records unrecoverable: back it up in a
# password manager. If it is unset, the app syncs in plaintext (cryptoVersion 0).
ENCRYPTION_MASTER_KEY=
